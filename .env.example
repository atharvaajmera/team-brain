# Required: Slack Bot Tokens (Get from https://api.slack.com/apps)
# Used for sending messages and reading messages the bot is tagged in
SLACK_BOT_TOKEN="xoxb-your-bot-token"

# Required: Slack App-Level Token (Starts with xapp-)
# Used to connect to Slack via Socket Mode (no public endpoints required)
SLACK_APP_TOKEN="xapp-1-your-app-token"

# Optional: Slack User Token (Starts with xoxp-)
# Used by sync_job.py to pull history from channels. 
# If not provided, it falls back to SLACK_BOT_TOKEN.
SLACK_USER_TOKEN="xoxp-your-user-token"

# Required: Groq API Key
# Used for the fast query planning and reasoning layer
GROQ_API_KEY="gsk_your_groq_api_key"

# Optional: Slack Workspace Name
# Used to generate correct permalinks for citations (e.g. "my-team")
SLACK_WORKSPACE="your-workspace-name"

# Optional: Local LLM Configuration (for privacy routing)
# Defaults to localhost and llama3.2 if not set
# OLLAMA_URL="http://localhost:11434/api/generate"
# MODEL="llama3.2"
