# Required: Slack Bot Tokens (Get from https://api.slack.com/apps)
# Used for sending messages and reading messages the bot is tagged in
SLACK_BOT_TOKEN="xoxb-your-bot-token"

# Required: Slack App-Level Token (Starts with xapp-)
# Used to connect to Slack via Socket Mode (no public endpoints required)
SLACK_APP_TOKEN="xapp-1-your-app-token"

PORT=8090

# Required: Groq API Key
# Used for the fast query planning and reasoning layer
GROQ_API_KEY="gsk_your_groq_api_key"

# Groq model used for planning, decomposition and answer generation
GROQ_MODEL="qwen/qwen3.6-27b"

# Ollama URL
OLLAMA_URL="ngrok URL"

#ollama model
MODEL="llama3.2"

# Workspace URL
SLACK_WORKSPACE="workspace-name" ## as in the slack workspace url


